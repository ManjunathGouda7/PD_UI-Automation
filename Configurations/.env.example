# Copy to Configurations/.env. Environment variables override jsons/Inputs.json.

# GRL software host. The versioned page (e.g. /v1.1.4.html) is resolved from the backend;
# set a full *.html URL here only to pin a specific page.
BASE_URL=http://localhost:5003
AUTO_DETECT_VERSION=true

# Tester IP used by the connect test (hardware action).
DUT_IP=192.168.255.1
DUT_PORT=5003

HEADLESS=true

# Safety switches
ALLOW_HW_ACTIONS=false     # true = also run tests that connect/apply config/attach/... on the tester
STRICT_HARDWARE=false      # true = fail instead of skip when a test needs a connected tester
MOCK_SERVER=false          # true = API tests against the offline mock (UI tests are skipped)

# Timing (milliseconds unless noted)
UI_TIMEOUT_MS=10000
PAGE_LOAD_TIMEOUT_MS=30000
AUTO_CONNECT_TIMEOUT_MS=90000
TESTER_WAIT_S=30
HEALTH_SAMPLES=5           # tester-link samples before a run (0 disables)
# E2E_TEST_KEY=TEST.PD.PHY.ALL.1 Transmit Bit Rate and the Drift
